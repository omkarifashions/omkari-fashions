# ---------- Server ----------
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/omkari_fashions

# ---------- Auth ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Cloudinary (leave empty to store uploads on local disk) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (Resend API) ----------
RESEND_API_KEY=
EMAIL_FROM="Omkari Fashions <onboarding@resend.dev>"
# Optional SMTP style values kept for reference / future providers
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# ---------- First admin (used by npm run seed:admin and npm run seed) ----------
ADMIN_NAME=Omkari Admin
ADMIN_EMAIL=admin@omkarifashions.com
ADMIN_PASSWORD=ChangeMe@123
